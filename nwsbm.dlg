/* nwsbm.dlg - dialog of nwsbm (stochastic block models fitted by variational EM). */
VERSION 14.0
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwsbm")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 580 640

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, title("nwsbm - Stochastic block model")
BEGIN
  TEXT tx_net 20 14 260 ., label("Network:")
  COMBOBOX cb_net 290 14 190 ., dropdown contents(netlist) nomem
  GROUPBOX gb_blk 10 44 560 126, label("Number of blocks (two numbers for a two-mode network: mode 1 and mode 2)")
  TEXT tx_blocks 20 64 260 ., label("Fixed number of blocks (blank = select by ICL):")
  EDIT ed_blocks 290 64 90 ., nomem
  TEXT tx_maxb 20 92 260 ., label("Maximum number of blocks to try (blank = default):")
  EDIT ed_maxb 290 92 90 ., nomem
  TEXT tx_minb 20 120 260 ., label("Minimum number of blocks to try (blank = 1):")
  EDIT ed_minb 290 120 90 ., nomem
  TEXT tx_blkn 20 146 540 ., label("Fixed number and maximum cannot be combined.")
  GROUPBOX gb_est 10 178 560 218, label("Estimation")
  TEXT tx_model 20 198 260 ., label("Edge model:")
  COMBOBOX cb_model 290 198 120 ., dropdownlist contents(modellist) values(modellist) default(bernoulli) nomem
  CHECKBOX cx_dc 420 198 140 ., label("degree corrected") onclickon(script dcon)
  TEXT tx_sig 20 224 260 ., label("Fixed variance (Gaussian; blank = estimate):")
  EDIT ed_sig 290 224 90 ., nomem
  CHECKBOX cx_bv 420 224 140 ., label("block variances") onclickon(script bvon)
  TEXT tx_rest 20 250 260 ., label("Random restarts per number of blocks (blank = default):")
  EDIT ed_rest 290 250 90 ., nomem
  TEXT tx_thr 20 276 260 ., label("Threads (0 = one per core):")
  SPINNER sp_thr 290 276 70 ., default(0) min(0) max(256) nomem
  CHECKBOX cx_fast 420 276 140 ., label("fast (fewer starts)")
  TEXT tx_seed 20 302 260 ., label("Random-number seed (blank = none):")
  EDIT ed_seed 290 302 90 ., nomem
  TEXT tx_icl 20 328 260 ., label("Criterion to select the number of blocks:")
  COMBOBOX cb_icl 290 328 120 ., dropdownlist contents(icllist) values(icllist) default(blockmodels) nomem
  CHECKBOX cx_greedy 420 328 140 ., label("greedy search")
  CHECKBOX cx_order 20 356 260 ., label("number the blocks by decreasing size")
  GROUPBOX gb_cov 10 404 560 120, label("Dyadic covariates (effects on the ties; not with degree correction)")
  TEXT tx_cov 20 424 260 ., label("Covariate networks (names, blank = none):")
  EDIT ed_cov 290 424 270 ., nomem
  TEXT tx_abs 20 450 260 ., label("Node variables: absolute difference:")
  EDIT ed_abs 290 450 270 ., nomem
  TEXT tx_same 20 476 260 ., label("Node variables: same value (0/1):")
  EDIT ed_same 290 476 270 ., nomem
  TEXT tx_sdiff 20 502 260 ., label("Node variables: signed difference (directed):")
  EDIT ed_sdiff 290 502 270 ., nomem
  GROUPBOX gb_out 10 532 560 64, label("Save results")
  TEXT tx_gen 20 554 260 ., label("Stub for memberships and probabilities:")
  EDIT ed_gen 290 554 110 ., nomem
  CHECKBOX cx_repl 420 554 140 ., label("replace existing")
END

SCRIPT dcon
BEGIN
	// degree correction needs the Poisson model
	main.cb_model.setvalue "poisson"
END

SCRIPT bvon
BEGIN
	// block-specific variances need the Gaussian model
	main.cb_model.setvalue "gaussian"
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

LIST icllist
BEGIN
	blockmodels
	exact
END

LIST modellist
BEGIN
	bernoulli
	poisson
	gaussian
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwsbm"
	stata hidden immediate
END

PROGRAM command
BEGIN
	if main.cb_net.iseq(" ") | main.cb_net.iseq("") {
		stopbox stop "Choose a network."
	}
	if main.ed_blocks.isneq("") & !main.ed_blocks.isnumlist() {
		stopbox stop "Number of blocks: enter an integer (two integers for a two-mode network)."
	}
	if main.ed_maxb.isneq("") & !main.ed_maxb.isnumlist() {
		stopbox stop "Maximum number of blocks: enter an integer (two for a two-mode network)."
	}
	if main.ed_minb.isneq("") & !main.ed_minb.isnumlist() {
		stopbox stop "Minimum number of blocks: enter an integer (two for a two-mode network)."
	}
	if main.ed_seed.isneq("") & !main.ed_seed.isnumlist() {
		stopbox stop "Seed: enter an integer."
	}
	if main.ed_sig.isneq("") & !main.ed_sig.isnumlist() {
		stopbox stop "Fixed variance: enter a positive number."
	}
	if main.ed_rest.isneq("") & !main.ed_rest.isnumlist() {
		stopbox stop "Restarts: enter a non-negative integer or leave blank."
	}
	if main.cx_dc & (main.ed_cov.isneq("") | main.ed_abs.isneq("") | main.ed_same.isneq("") | main.ed_sdiff.isneq("")) {
		stopbox stop "Covariates cannot be combined with the degree-corrected model."
	}
	if main.ed_blocks.isneq("") & main.ed_maxb.isneq("") {
		stopbox stop "Choose either a fixed number of blocks or a maximum, not both."
	}
	if main.cx_dc & main.cb_model.isneq("poisson") {
		stopbox stop "The degree-corrected model needs the Poisson edge model."
	}
	if main.cx_bv & (main.cb_model.isneq("gaussian") | main.ed_sig.isneq("") | main.cx_dc) {
		stopbox stop "Block-specific variances need the Gaussian edge model, no fixed variance and no degree correction."
	}
	if main.cx_bv & (main.ed_cov.isneq("") | main.ed_abs.isneq("") | main.ed_same.isneq("") | main.ed_sdiff.isneq("")) {
		stopbox stop "Covariates cannot be combined with block-specific variances."
	}
	if main.cx_greedy & main.cb_icl.isneq("exact") {
		stopbox stop "The greedy search needs the exact ICL."
	}
	if main.cx_greedy & main.cx_fast {
		stopbox stop "The greedy search cannot be combined with fast."
	}
	if main.ed_sig.isneq("") & main.cb_model.isneq("gaussian") {
		stopbox stop "A fixed variance needs the Gaussian edge model."
	}
	if main.cx_repl & main.ed_gen.iseq("") {
		stopbox stop "replace needs a stub for the new variables."
	}
	put "nwsbm " main.cb_net
	put ","
	if main.ed_blocks.isneq("") {
		put " blocks(" main.ed_blocks ")"
	}
	if main.ed_maxb.isneq("") {
		put " maxblocks(" main.ed_maxb ")"
	}
	if main.ed_minb.isneq("") {
		put " minblocks(" main.ed_minb ")"
	}
	if main.cb_model.isneq("bernoulli") {
		put " model(" main.cb_model ")"
	}
	if main.cx_dc {
		put " degreecorrected"
	}
	if main.ed_sig.isneq("") {
		put " sigma2(" main.ed_sig ")"
	}
	if main.cx_bv {
		put " blockvar"
	}
	if main.cb_icl.isneq("blockmodels") {
		put " icl(" main.cb_icl ")"
	}
	if main.cx_greedy {
		put " greedy"
	}
	if main.cx_order {
		put " orderblocks"
	}
	if main.ed_rest.isneq("") {
		put " restarts(" main.ed_rest ")"
	}
	if !main.sp_thr.isdefault() {
		put " threads(" main.sp_thr ")"
	}
	if main.cx_fast {
		put " fast"
	}
	if main.ed_seed.isneq("") {
		put " seed(" main.ed_seed ")"
	}
	if main.ed_cov.isneq("") {
		put " covariates(" main.ed_cov ")"
	}
	if main.ed_abs.isneq("") {
		put " absdiff(" main.ed_abs ")"
	}
	if main.ed_same.isneq("") {
		put " same(" main.ed_same ")"
	}
	if main.ed_sdiff.isneq("") {
		put " signeddiff(" main.ed_sdiff ")"
	}
	if main.ed_gen.isneq("") {
		put " generate(" main.ed_gen ")"
	}
	if main.cx_repl {
		put " replace"
	}
	stata
END
