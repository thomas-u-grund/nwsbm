/* nwsbmplot.dlg - dialog of nwsbmplot (plots after nwsbm: blocked adjacency matrix and block graph). */
VERSION 14.0
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwsbmplot")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 520 300

DIALOG main, title("nwsbmplot - Plots of a stochastic block model")
BEGIN
  TEXT tx_type 20 14 200 ., label("Plot:")
  COMBOBOX cb_type 230 14 200 ., dropdownlist contents(typelist) values(typevalues) default(matrix) nomem
  GROUPBOX gb_mat 10 44 500 114, label("Blocked adjacency matrix")
  CHECKBOX cx_shade 20 64 460 ., label("shade the blocks by their connectivity")
  CHECKBOX cx_nolines 20 90 460 ., label("no lines between the blocks")
  CHECKBOX cx_missing 20 116 460 ., label("show missing ties")
  CHECKBOX cx_nolabels 20 136 460 ., label("no block labels on the axes")
  GROUPBOX gb_gen 10 166 500 120, label("Graph")
  TEXT tx_title 20 186 200 ., label("Title (blank = default):")
  EDIT ed_title 230 186 260 ., nomem
  TEXT tx_name 20 214 200 ., label("Graph name:")
  EDIT ed_name 230 214 120 ., nomem
  TEXT tx_save 20 242 200 ., label("Save graph to file (.gph):")
  FILE fi_save 230 242 260 ., save label("Browse...") filter("Stata graph (*.gph)|*.gph|All (*.*)|*.*") nomem
END

LIST typelist
BEGIN
	Blocked adjacency matrix
	Block graph
END

LIST typevalues
BEGIN
	matrix
	blocks
END

PROGRAM command
BEGIN
	put "nwsbmplot,"
	if main.cb_type.isneq("matrix") {
		put " type(" main.cb_type ")"
	}
	if main.cx_shade {
		put " shade"
	}
	if main.cx_nolines {
		put " nolines"
	}
	if main.cx_missing {
		put " missing"
	}
	if main.cx_nolabels {
		put " nolabels"
	}
	if main.ed_title.isneq("") {
		put " title(" main.ed_title ")"
	}
	if main.ed_name.isneq("") {
		put " name(" main.ed_name ")"
	}
	if main.fi_save.isneq("") {
		put " saving(" main.fi_save ")"
	}
	stata
END
