/* nwsbmplot.dlg - dialog of nwsbmplot (plots after nwsbm: blocked matrix, expected ties, memberships, block graph, ICL path). */
VERSION 14.0
INCLUDE _std_small
SYNCHRONOUS_ONLY
HELP hlp1, view("help nwsbmplot")
OK ok1, label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
RESET res1
POSITION 10 10 520 480

DIALOG main, title("nwsbmplot - Plots of a stochastic block model")
BEGIN
  TEXT tx_type 20 14 200 ., label("Plot:")
  COMBOBOX cb_type 230 14 200 ., dropdownlist contents(typelist) values(typevalues) default(matrix) nomem
  GROUPBOX gb_mat 10 44 500 134, label("Blocked adjacency matrix")
  CHECKBOX cx_shade 20 64 460 ., label("shade the blocks by their connectivity")
  CHECKBOX cx_nolines 20 90 460 ., label("no lines between the blocks")
  CHECKBOX cx_missing 20 116 460 ., label("show missing ties")
  CHECKBOX cx_nolabels 20 136 460 ., label("no block labels on the axes")
  CHECKBOX cx_sort 20 156 460 ., label("order actors within a block by certainty (matrix, expected ties)")
  GROUPBOX gb_gen 10 186 500 286, label("Graph")
  TEXT tx_col 20 206 200 ., label("Colours of the blocks (list):")
  EDIT ed_col 230 206 260 ., nomem
  TEXT tx_title 20 234 200 ., label("Title (blank = default):")
  EDIT ed_title 230 234 260 ., nomem
  TEXT tx_name 20 262 200 ., label("Graph name:")
  EDIT ed_name 230 262 120 ., nomem
  TEXT tx_save 20 290 200 ., label("Save graph to file (.gph):")
  FILE fi_save 230 290 260 ., save label("Browse...") filter("Stata graph (*.gph)|*.gph|All (*.*)|*.*") nomem
  TEXT tx_exp 20 318 200 ., label("Export graph to file (.png, .pdf):")
  FILE fi_exp 230 318 260 ., save label("Browse...") filter("PNG (*.png)|*.png|PDF (*.pdf)|*.pdf|All (*.*)|*.*") nomem
  TEXT tx_bl 20 346 200 ., label("Names of the blocks (list):")
  EDIT ed_bl 230 346 260 ., nomem
  TEXT tx_al 20 374 200 ., label("Actor labels (variable, up to 40 actors):")
  VARNAME vn_al 230 374 260 ., nomem
  TEXT tx_lc 20 402 200 ., label("Colour of the block lines:")
  EDIT ed_lc 230 402 120 ., nomem
  CHECKBOX cx_nolg 20 430 460 ., label("no legend (ICL plot, membership)")
END

LIST typelist
BEGIN
	Blocked adjacency matrix
	Expected ties
	Membership probabilities
	Block graph
	ICL by number of blocks
END

LIST typevalues
BEGIN
	matrix
	expected
	membership
	blocks
	icl
END

PROGRAM command
BEGIN
	put "nwsbmplot,"
	if main.cb_type.isneq("matrix") {
		put " type(" main.cb_type ")"
	}
	if main.cx_shade {
		put " shade"
	}
	if main.cx_nolines {
		put " nolines"
	}
	if main.cx_missing {
		put " missing"
	}
	if main.cx_nolabels {
		put " nolabels"
	}
	if main.cx_sort {
		put " sort"
	}
	if main.ed_col.isneq("") {
		put " colors(" main.ed_col ")"
	}
	if main.ed_bl.isneq("") {
		put " blocklabels(" main.ed_bl ")"
	}
	if main.vn_al.isneq("") {
		put " actorlabels(" main.vn_al ")"
	}
	if main.ed_lc.isneq("") {
		put " linecolor(" main.ed_lc ")"
	}
	if main.cx_nolg {
		put " nolegend"
	}
	if main.ed_title.isneq("") {
		put " title(" main.ed_title ")"
	}
	if main.ed_name.isneq("") {
		put " name(" main.ed_name ")"
	}
	if main.fi_save.isneq("") {
		put " saving(" main.fi_save ")"
	}
	if main.fi_exp.isneq("") {
		put " export(" main.fi_exp ")"
	}
	stata
END
